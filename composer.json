{
    "name": "laminas/laminas-hydrator",
    "description": "Serialize objects to arrays, and vice versa",
    "license": "BSD-3-Clause",
    "keywords": [
        "laminas",
        "hydrator"
    ],
    "homepage": "https://laminas.dev",
    "support": {
        "docs": "https://docs.laminas.dev/laminas-hydrator/",
        "issues": "https://github.com/laminas/laminas-hydrator/issues",
        "source": "https://github.com/laminas/laminas-hydrator",
        "rss": "https://github.com/laminas/laminas-hydrator/releases.atom",
        "chat": "https://laminas.dev/chat",
        "forum": "https://discourse.laminas.dev"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.3.99"
        }
    },
    "extra": {
        "laminas": {
            "component": "Laminas\\Hydrator",
            "config-provider": "Laminas\\Hydrator\\ConfigProvider"
        }
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "laminas/laminas-eventmanager": "^3.15",
        "laminas/laminas-serializer": "^4.0.0",
        "laminas/laminas-servicemanager": "^4.5.1",
        "laminas/laminas-stdlib": "^3.22",
        "psr/container": "^1.1 || ^2.0.2",
        "webmozart/assert": "^1.11 || ^2.5"
    },
    "require-dev": {
        "boundwize/structarmed": "^0.21.0",
        "laminas/internal-tooling": "^1.0",
        "laminas/laminas-coding-standard": "^3.1",
        "phpbench/phpbench": "^1.7.0",
        "phpunit/phpunit": "^11.5.57",
        "psalm/plugin-phpunit": "^0.22.0",
        "rector/rector": "^2.8.4",
        "shipmonk/composer-dependency-analyser": "^1.8.4",
        "vimeo/psalm": "^6.20.10"
    },
    "autoload": {
        "psr-4": {
            "Laminas\\Hydrator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaminasTest\\Hydrator\\": "test/",
            "LaminasBench\\Hydrator\\": "benchmark/"
        }
    },
    "scripts": {
        "benchmark": "phpbench run --revs=2 --iterations=2 --report=aggregate",
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@rector",
            "@dep-analysis"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "dep-analysis": "composer-dependency-analyser",
        "rector": "rector -n",
        "rector:fix": "rector",
        "static-analysis": "psalm --shepherd --stats",
        "static-analysis:b": "psalm --update-baseline",
        "static-analysis:clear": "psalm --clear-cache",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    },
    "conflict": {
        "zendframework/zend-hydrator": "*",
        "laminas/laminas-servicemanager": "<3.14.0"
    }
}
